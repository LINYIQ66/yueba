.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

/* 发布者 */
.host-row {
  display: flex;
  align-items: center;
}

.host-info {
  margin-left: 20rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.host-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.host-meta {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.host-intro {
  font-size: 24rpx;
  color: #888;
  margin-top: 10rpx;
  line-height: 1.5;
}

/* 邀约详情 */
.type-badge {
  display: inline-block;
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.detail-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #222;
  margin-bottom: 12rpx;
}

.detail-desc {
  display: block;
  font-size: 28rpx;
  color: #555;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.detail-meta {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.meta-label {
  font-size: 26rpx;
  color: #999;
  min-width: 100rpx;
}

.meta-value {
  font-size: 26rpx;
  color: #333;
}

/* 标题 */
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

/* 报名人头像 */
.participant-scroll {
  white-space: nowrap;
  padding: 10rpx 0;
}

.participant-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin-right: 30rpx;
  width: 100rpx;
}

.participant-item .avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
}

.p-name {
  font-size: 22rpx;
  color: #666;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100rpx;
}

/* 操作栏 */
.action-bar {
  padding: 0 30rpx;
  margin-bottom: 20rpx;
}

.joined-actions {
  display: flex;
  gap: 20rpx;
}

.joined-actions .btn-primary {
  flex: 1;
  padding: 20rpx 0;
  font-size: 28rpx;
}

.joined-actions .btn-outline {
  flex: 0 0 auto;
  padding: 16rpx 30rpx;
  font-size: 26rpx;
}

/* 联系卡片 */
.contact-card {
  margin-top: 10rpx;
}

.contact-hint {
  font-size: 26rpx;
  color: #999;
  line-height: 1.5;
}
