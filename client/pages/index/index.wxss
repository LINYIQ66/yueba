.page {
  padding-bottom: 40rpx;
}

/* 头部 */
.header-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 60rpx 30rpx 30rpx;
  background: linear-gradient(135deg, #FF6B81, #FF8E9E);
  color: #fff;
}

.greeting {
  display: flex;
  flex-direction: column;
}

.greeting-title {
  font-size: 40rpx;
  font-weight: 700;
}

.greeting-sub {
  font-size: 26rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

.profile-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.6);
  overflow: hidden;
}

.profile-btn .avatar {
  width: 100%;
  height: 100%;
}

/* 分类标签 */
.type-tabs {
  white-space: nowrap;
  padding: 20rpx 30rpx;
  background: #fff;
}

.type-tab {
  display: inline-block;
  padding: 12rpx 30rpx;
  margin-right: 16rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  background: #f5f5f5;
  color: #666;
}

.type-tab.active {
  background: #FF6B81;
  color: #fff;
}

/* 邀约卡片 */
.invitation-list {
  padding: 20rpx 30rpx;
}

.invitation-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.user-row {
  display: flex;
  align-items: center;
}

.user-row .avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.user-info {
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.meta {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.type-badge {
  padding: 6rpx 20rpx;
  border-radius: 30rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.type-1 { background: #FFF0E6; color: #FF8C42; }
.type-2 { background: #E8F0FE; color: #4285F4; }
.type-3 { background: #E8F8E8; color: #34A853; }
.type-4 { background: #F3E8FF; color: #9334E6; }

.card-body {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.card-body .title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
}

.card-body .desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

.info-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.info-icon {
  font-size: 24rpx;
}

.info-text {
  font-size: 24rpx;
  color: #999;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #f0f0f0;
}

.participant-count {
  font-size: 24rpx;
  color: #999;
}
