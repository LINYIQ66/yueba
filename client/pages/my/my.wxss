.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

/* 头部 */
.my-header {
  display: flex;
  align-items: center;
  padding: 40rpx 30rpx;
  background: linear-gradient(135deg, #FF6B81, #FF8E9E);
  color: #fff;
}

.my-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.my-name {
  font-size: 34rpx;
  font-weight: 700;
}

.my-meta {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 4rpx;
}

.my-intro {
  font-size: 24rpx;
  opacity: 0.8;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 400rpx;
}

.edit-btn {
  font-size: 24rpx;
  opacity: 0.8;
  padding: 10rpx 20rpx;
  border: 2rpx solid rgba(255,255,255,0.5);
  border-radius: 30rpx;
}

/* Tab */
.tab-bar {
  display: flex;
  background: #fff;
  border-bottom: 2rpx solid #f0f0f0;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #999;
  position: relative;
}

.tab.active {
  color: #FF6B81;
  font-weight: 600;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 30%;
  right: 30%;
  height: 4rpx;
  background: #FF6B81;
  border-radius: 2rpx;
}

/* 状态标签 */
.status-tag {
  padding: 6rpx 18rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
}

.status-tag.active {
  background: #E8F8E8;
  color: #34A853;
}

.status-tag.closed {
  background: #f0f0f0;
  color: #999;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-body {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.card-body .title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.info-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.info-icon {
  font-size: 24rpx;
}

.info-text {
  font-size: 24rpx;
  color: #999;
}

.invitation-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin: 16rpx 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}
