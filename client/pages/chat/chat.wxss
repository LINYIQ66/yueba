.page {
  min-height: 100vh;
  background: #fff;
}

.chat-list {
  padding: 0;
}

.conversation-item {
  display: flex;
  padding: 24rpx 30rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.conversation-item:active {
  background: #f9f9f9;
}

.conversation-item .avatar {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.conv-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.conv-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.conv-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.conv-time {
  font-size: 22rpx;
  color: #bbb;
}

.conv-title {
  font-size: 24rpx;
  color: #FF6B81;
  margin-top: 4rpx;
}

.conv-preview {
  font-size: 26rpx;
  color: #999;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
