.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 60rpx;
}

.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.avatar-hint {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
}

.gender-select {
  display: flex;
  gap: 16rpx;
}

.gender-option {
  flex: 1;
  text-align: center;
  padding: 18rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  border: 2rpx solid #eee;
  font-size: 28rpx;
  color: #666;
}

.gender-option.active {
  background: #FFF0F2;
  border-color: #FF6B81;
  color: #FF6B81;
}

/* 标签 */
.tag-select {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-item {
  padding: 12rpx 24rpx;
  background: #f9f9f9;
  border-radius: 30rpx;
  border: 2rpx solid #eee;
  font-size: 26rpx;
  color: #666;
}

.tag-item.active {
  background: #FFF0F2;
  border-color: #FF6B81;
  color: #FF6B81;
}
