/** app.wxss **/
@import './styles/weui.wxss';

page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.container {
  padding: 20rpx 30rpx;
}

/* 按钮样式 */
.btn-primary {
  background: linear-gradient(135deg, #FF6B81, #FF8E9E);
  color: #fff;
  border: none;
  border-radius: 50rpx;
  padding: 24rpx 0;
  font-size: 32rpx;
  width: 100%;
  text-align: center;
}

.btn-primary:active {
  opacity: 0.8;
}

.btn-primary.small {
  padding: 16rpx 40rpx;
  width: auto;
  font-size: 28rpx;
}

.btn-outline {
  background: transparent;
  color: #FF6B81;
  border: 2rpx solid #FF6B81;
  border-radius: 50rpx;
  padding: 14rpx 36rpx;
  font-size: 28rpx;
  text-align: center;
}

/* 卡片样式 */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 28rpx;
}

.empty-state .icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 26rpx;
}

/* 标签 */
.tag {
  display: inline-block;
  background: #FFF0F2;
  color: #FF6B81;
  padding: 6rpx 18rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
  margin-right: 10rpx;
}

/* 输入框 */
.input-group {
  margin-bottom: 30rpx;
}

.input-group label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
  font-weight: 600;
}

.input-group input,
.input-group textarea {
  width: 100%;
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: 2rpx solid #eee;
  box-sizing: border-box;
}

.input-group textarea {
  min-height: 160rpx;
}

/* 头像 */
.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #eee;
}

.avatar.large {
  width: 120rpx;
  height: 120rpx;
}
